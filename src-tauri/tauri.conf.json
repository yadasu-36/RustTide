{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustTide",
  "version": "0.2.0",
  "identifier": "io.github.rusttide",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustTide 设置",
        "width": 810,
        "height": 790,
        "minWidth": 680,
        "minHeight": 580,
        "visible": false,
        "skipTaskbar": true,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Translate selected text and replace it in place",
    "copyright": "Copyright (c) 2026 yadasu-36",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    }
  }
}
